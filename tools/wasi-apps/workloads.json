{
  "schema_version": 2,
  "control_workload": "quickjs-loop",
  "workloads": [
    {
      "name": "quickjs-loop",
      "class": "compute",
      "headline": true,
      "runner": "program",
      "description": "Arithmetic loop in QuickJS; compute parity against Linux+Wasmtime.",
      "program": "{quickjs}",
      "args": [
        "-e",
        "let s = 0; for (let i = 0; i < 250000; i++) s = (s + ((i * 17) % 97)) | 0; console.log(\"quickjs-loop:\" + s);"
      ],
      "boot_programs": [
        "quickjs"
      ],
      "stdout_contains": [
        "quickjs-loop:"
      ],
      "stderr_empty": true,
      "counterparts": {
        "linux_native": {
          "inherit": true
        },
        "linux_wasmtime": {
          "wasm_path": "artifacts/wasix/quickjs/qjs.wasm",
          "args": [
            "-e",
            "let s = 0; for (let i = 0; i < 250000; i++) s = (s + ((i * 17) % 97)) | 0; console.log(\"quickjs-loop:\" + s);"
          ]
        }
      }
    },
    {
      "name": "cpython-json",
      "class": "compute",
      "headline": true,
      "runner": "program",
      "description": "Parse and serialize JSON repeatedly in CPython.",
      "program": "{python3}",
      "args": [
        "-c",
        "import json; data=[{\"i\":i,\"s\":str(i)} for i in range(800)]; total=sum(len(json.loads(json.dumps(data,separators=(\",\",\":\")))) for _ in range(40)); print(f\"cpython-json:{total}\")"
      ],
      "boot_programs": [
        "python3"
      ],
      "stdout_contains": [
        "cpython-json:32000"
      ],
      "counterparts": {
        "linux_native": {
          "inherit": true
        },
        "linux_wasmtime": {
          "wasm_path": "artifacts/python3-root/python3.wasm",
          "guest_paths": [
            "artifacts/python3-root"
          ],
          "wasmtime_flags": [
            "--dir",
            "{repo_root}/artifacts/python3-root::/"
          ],
          "args": [
            "-c",
            "import json; data=[{\"i\":i,\"s\":str(i)} for i in range(800)]; total=sum(len(json.loads(json.dumps(data,separators=(\",\",\":\")))) for _ in range(40)); print(f\"cpython-json:{total}\")"
          ]
        }
      }
    },
    {
      "name": "cpython-regex",
      "class": "compute",
      "headline": false,
      "runner": "program",
      "description": "Regex and text processing loop in CPython.",
      "program": "{python3}",
      "args": [
        "-c",
        "import re; text=(\"alpha123 beta456 gamma789 delta000\\n\"*2000); total=sum(len(re.findall(r\"[a-z]+\\d+\", text)) for _ in range(80)); print(f\"cpython-regex:{total}\")"
      ],
      "boot_programs": [
        "python3"
      ],
      "stdout_contains": [
        "cpython-regex:640000"
      ],
      "counterparts": {
        "linux_native": {
          "inherit": true
        },
        "linux_wasmtime": {
          "wasm_path": "artifacts/python3-root/python3.wasm",
          "guest_paths": [
            "artifacts/python3-root"
          ],
          "wasmtime_flags": [
            "--dir",
            "{repo_root}/artifacts/python3-root::/"
          ],
          "args": [
            "-c",
            "import re; text=(\"alpha123 beta456 gamma789 delta000\\n\"*2000); total=sum(len(re.findall(r\"[a-z]+\\d+\", text)) for _ in range(80)); print(f\"cpython-regex:{total}\")"
          ]
        }
      }
    },
    {
      "name": "aot-curl",
      "class": "compute",
      "headline": false,
      "runner": "helios-aot",
      "description": "Compiler-plugin AOT timing for the curl wasm artifact against `wasmtime compile` of the same input.",
      "wasm_path": "artifacts/wasi-tools/curl.wasm",
      "remote_path": "/aot-bench-curl-input.wasm",
      "destination_path": "/aot-bench-curl-output.cwasm",
      "counterparts": {
        "linux_native": null,
        "linux_wasmtime": {
          "program": "{wasmtime}",
          "args": [
            "compile",
            "-o",
            "{workdir}/aot-curl-output.cwasm",
            "{guest:artifacts/wasi-tools/curl.wasm}"
          ]
        }
      }
    },
    {
      "name": "wasm-simd-lanes",
      "class": "compute",
      "headline": false,
