      "class": "startup",
      "headline": false,
      "runner": "program",
      "description": "Time to first output of one freshly spawned instance, and its memory footprint.",
      "program": "/bin/procbench",
      "args": [
        "startup",
        "1",
        "/bin/hello",
        "hold"
      ],
      "boot_programs": [
        "procbench",
        "hello"
      ],
      "stdout_contains": [
        "instance-startup:1"
      ],
      "stderr_empty": true,
      "counterparts": {
        "linux_native": {
          "program": "{native_bin}/procbench",
          "args": [
            "startup",
            "1",
            "{native_bin}/hello",
            "hold"
          ]
        },
        "linux_wasmtime": {
          "program": "{native_bin}/procbench",
          "args": [
            "startup",
            "1",
            "{wasmtime_run}",
            "{cwasm:artifacts/wasi-tools/hello.wasm}",
            "hold"
          ]
        }
