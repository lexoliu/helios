{% macro cell(workload, side) -%}
{% set cell = workload.cells.get(side) %}
{% if cell is none %}{% if side in workload.failures %}**failed**{% else %}n/a{% endif %}{% else %}{{ cell.warm.median | ms }} {{ cell.warm.ci_low | ci(cell.warm.ci_high) }}{% if cell.rejected %} (rejected){% endif %}{% endif %}
{%- endmacro %}
{% macro speedup(workload, side) -%}
{% set found = namespace(text="n/a") %}
{% for comparison in workload.comparisons %}
{% if comparison.against == side %}
{% set found.text = comparison.speedup | speedup ~ ("" if comparison.significant and comparison.beyond_noise else " (within noise)") %}
{% endif %}
{% endfor %}
{{ found.text }}
{%- endmacro %}
{% macro row(workload, sides) -%}
| `{{ workload.name }}`{% if workload.headline %} (headline){% endif %}{% if workload.parity_bug %} **parity bug**{% endif %}{% for side in sides %} | {{ cell(workload, side) }}{% endfor %} | {{ speedup(workload, Side.LINUX_WASMTIME) }} | {{ speedup(workload, Side.LINUX_NATIVE) }} |
{%- endmacro %}
{% macro header(sides) -%}
| Workload{% for side in sides %} | {{ SIDE_LABELS[side] }}{% endfor %} | vs Wasmtime | vs native |
| ---{% for side in sides %} | ---:{% endfor %} | ---: | ---: |
{%- endmacro %}
