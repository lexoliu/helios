package helios:kernel@0.1.0;

world init {
  include wasi:cli/command@0.3.0;
  import helios:system/programs@0.1.0;
  import helios:system/net@0.1.0;
  import helios:system/vsock@0.1.0;
  import helios:system/stats@0.1.0;
  import helios:system/tracing@0.1.0;
  import helios:system/profiling@0.1.0;
  import helios:system/sync@0.1.0;
  import helios:system/serial@0.1.0;
  import helios:system/display@0.1.0;
  import helios:system/input@0.1.0;
  import helios:system/surface@0.1.0;
  import helios:system/gpu@0.1.0;
  import wasi:http/types@0.3.0;
  import wasi:http/client@0.3.0;
}

world debugger {
  include wasi:cli/command@0.3.0;
  import helios:system/programs@0.1.0;
  import helios:system/net@0.1.0;
  import helios:system/vsock@0.1.0;
  import helios:system/stats@0.1.0;
  import helios:system/tracing@0.1.0;
  import helios:system/profiling@0.1.0;
  import helios:system/sync@0.1.0;
  import helios:system/serial@0.1.0;
  import helios:system/instances@0.1.0;
  import helios:system/display@0.1.0;
  import helios:system/input@0.1.0;
  import helios:system/surface@0.1.0;
  import helios:system/gpu@0.1.0;
  import wasi:http/types@0.3.0;
  import wasi:http/client@0.3.0;
}

/// World implemented by the `http-client` kernel plugin: it speaks HTTP over
/// the kernel's sockets and answers exchanges the kernel forwards to it.
///
/// The plugin must not import `wasi:http/client` — it *is* the client.
world http-handler {
  include wasi:cli/imports@0.3.0;
  import helios:system/net@0.1.0;
  import helios:system/sync@0.1.0;
  import wasi:http/types@0.3.0;
  export wasi:http/handler@0.3.0;
}

/// World the kernel generates its own `wasi:http` bindings from.
///
/// The import half (`types`, `client`) is what the kernel implements for
/// every program store; the export half (`handler`) is the call the plugin
/// runner makes into the `http-client` plugin's store. Keeping this world
/// separate from `http-handler` keeps the kernel's bindgen down to the two
/// interfaces it actually serves instead of regenerating every `wasi:cli`
/// import that `wasi/bindings.rs` already provides.
world http-host {
  import wasi:http/types@0.3.0;
  import wasi:http/client@0.3.0;
  export wasi:http/handler@0.3.0;
}

world remote-system {
  export helios:system/programs@0.1.0;
  export helios:system/net@0.1.0;
  export helios:system/stats@0.1.0;
  export helios:system/tracing@0.1.0;
  export helios:system/profiling@0.1.0;
  export helios:system/sync@0.1.0;
  export helios:system/serial@0.1.0;
  export helios:system/instances@0.1.0;
}

/// World a kernel plugin that drives one device outside the virtio
/// ecosystem implements.
///
/// It is an ordinary user-mode component with the ordinary isolation model;
/// what makes it a driver is the grant the kernel hands it, and nothing else.
/// The driver-class interface it exports back to the kernel — block, net,
/// serial — is not here yet.
world device-driver {
  include wasi:cli/imports@0.3.0;
  import helios:system/device@0.1.0;
  import helios:system/sync@0.1.0;
  import helios:system/tracing@0.1.0;
}

/// World the kernel generates its own `helios:system/device` bindings from.
///
/// Separate from `device-driver` for the same reason `http-host` is separate
/// from `http-handler`: this keeps the kernel's bindgen down to the one
/// interface it serves instead of regenerating every `wasi:cli` import the
/// program bindings already provide.
world device-host {
  import helios:system/device@0.1.0;
}

/// World the kernel generates its own `helios:system/display` bindings
/// from.
///
/// Separate from the program worlds for the same reason `device-host` is
/// separate from `device-driver`: it keeps the kernel's bindgen down to
/// the one interface it serves here instead of regenerating every
/// `wasi:cli` import the program bindings already provide.
world display-host {
  import helios:system/display@0.1.0;
}

/// World the kernel generates its own `helios:system/input` bindings
/// from.
///
/// Separate from the program worlds for the same reason `display-host`
/// is: it keeps the kernel's bindgen down to the one interface it serves
/// here instead of regenerating every `wasi:cli` import the program
/// bindings already provide.
world input-host {
  import helios:system/input@0.1.0;
}

/// World implemented by the `compositor` kernel plugin: it owns the
/// display and every input device, composes the desktop, and answers the
/// surface calls the kernel forwards to it.
///
/// It must not import `helios:system/surface` — it *is* the compositor —
/// except for `deliver`, which is how the input it routed reaches the
/// client that owns the focused surface. There is no `wasi:cli/run`
/// here: the supervisor spawns `compositor.run` as a task of the same
/// store the surface calls are dispatched into, so composition and the
/// calls into it are concurrent inside one instance.
world compositor {
  include wasi:cli/imports@0.3.0;
  import helios:system/programs@0.1.0;
  import helios:system/display@0.1.0;
  import helios:system/input@0.1.0;
  import helios:system/surface@0.1.0;
  import helios:system/gpu@0.1.0;
  import helios:system/sync@0.1.0;
  import helios:system/tracing@0.1.0;
  export helios:system/compositor@0.1.0;
}

/// World the kernel generates its own `helios:system/surface` bindings
/// from.
///
/// Separate from the program worlds for the same reason `display-host`
/// is: it keeps the kernel's bindgen down to the one interface it serves
/// here instead of regenerating every `wasi:cli` import the program
/// bindings already provide.
world surface-host {
  import helios:system/surface@0.1.0;
}

/// World the kernel generates its own `helios:system/gpu` bindings
/// from.
///
/// Separate from the program worlds for the same reason `display-host`
/// is: it keeps the kernel's bindgen down to the one interface it serves
/// here instead of regenerating every `wasi:cli` import the program
/// bindings already provide.
world gpu-host {
  import helios:system/gpu@0.1.0;
}

/// World the kernel generates the compositor plugin's *export* bindings
/// from, the way `http-host` carries `wasi:http/handler`.
world compositor-host {
  export helios:system/compositor@0.1.0;
}
