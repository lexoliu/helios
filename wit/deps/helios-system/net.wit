package helios:system@0.1.0;

interface net {
  /// Monotonic nanoseconds since system boot.
  type mono-nanos = u64;

  type ipv4-address = tuple<u8, u8, u8, u8>;
  type ipv6-address = tuple<u16, u16, u16, u16, u16, u16, u16, u16>;

  variant ip-address {
    ipv4(ipv4-address),
    ipv6(ipv6-address),
  }

  record ping-reply {
    address: ip-address,
    round-trip: mono-nanos,
    payload-bytes: u16,
  }

  enum ping-error-kind {
    unresolved-host,
    timeout,
    unavailable,
    internal,
  }

  record ping-error {
    kind: ping-error-kind,
    detail: string,
  }

  enum tcp-error-kind {
    unresolved-host,
    timeout,
    /// The peer reset the connection.
    connection-reset,
    /// The connection was aborted before the stream ended.
    connection-aborted,
    unavailable,
    internal,
  }

  record tcp-error {
    kind: tcp-error-kind,
    detail: string,
  }

  enum udp-error-kind {
    unresolved-host,
    timeout,
    permission-denied,
    unavailable,
    internal,
  }

  record udp-error {
    kind: udp-error-kind,
    detail: string,
  }

  record udp-datagram {
    address: ip-address,
    port: u16,
    bytes: list<u8>,
  }

  resource tcp-stream {
    /// Reads up to `max-bytes` octets from the peer.
    ///
    /// `none` indicates an orderly EOF after the peer closed its transmit side.
    /// A connection that ended any other way fails immediately with
    /// `connection-reset` or `connection-aborted` rather than waiting out
    /// `timeout`.
    read: async func(max-bytes: u32, timeout: mono-nanos) -> result<option<list<u8>>, tcp-error>;

    /// Writes the complete `bytes` buffer before returning.
    write: async func(bytes: list<u8>, timeout: mono-nanos) -> result<u64, tcp-error>;

    /// Releases the underlying TCP socket immediately.
    close: async func() -> result<_, tcp-error>;
  }

  resource udp-socket {
    /// Receives one datagram from the bound local port.
    ///
    /// `none` indicates that the socket was closed before a datagram arrived.
    receive: async func(max-bytes: u32, timeout: mono-nanos) -> result<option<udp-datagram>, udp-error>;

    /// Sends one datagram to `host:port`.
    send: async func(host: string, port: u16, bytes: list<u8>, timeout: mono-nanos) -> result<u64, udp-error>;

    /// Releases the underlying UDP socket immediately.
    close: async func() -> result<_, udp-error>;
  }

  /// Resolves `host` and sends one ICMP echo request through the platform network stack.
  ping: async func(host: string, timeout: mono-nanos) -> result<ping-reply, ping-error>;

  /// Resolves `host` and opens an outbound TCP stream to `port`.
  tcp-connect: async func(host: string, port: u16, timeout: mono-nanos) -> result<tcp-stream, tcp-error>;

  /// Binds a UDP socket to `local-port`. `0` requests an ephemeral port.
  udp-bind: async func(local-port: u16) -> result<udp-socket, udp-error>;
}
