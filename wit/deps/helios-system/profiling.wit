package helios:system@0.1.0;

interface profiling {
  type mono-nanos = u64;

  enum scope {
    kernel,
    user,
  }

  record filter {
    scope: option<scope>,
    stack-prefixes: list<string>,
  }

  record folded-sample {
    scope: scope,
    stack: string,
    weight: mono-nanos,
  }

  record metric-filter {
    name-prefixes: list<string>,
  }

  record metric-sample {
    scope: scope,
    name: string,
    count: u64,
    total-events: u64,
    total-nanos: mono-nanos,
    min-nanos: mono-nanos,
    max-nanos: mono-nanos,
    total-bytes: u64,
    total-reference-cycles: u64,
    total-cpu-cycles: u64,
    total-instructions-retired: u64,
  }

  /// A section of the kernel image's LLVM instrumentation.
  enum profile-section {
    counters,
    data,
    names,
  }

  /// Why the kernel could not produce an LLVM raw profile.
  variant raw-profile-error {
    /// The running kernel carries no instrumentation: it was not built
    /// with the `profile-generate` profile.
    not-instrumented,
    /// The image's `__llvm_profile_raw_version`, which is not the raw
    /// profile version the kernel's writer implements.
    unsupported-version(u64),
    /// A section whose length is not a whole number of its records.
    malformed-section(profile-section),
    /// The length of the profile, which the requested offset is past.
    out-of-range(u64),
    /// The largest window one read serves, which the request exceeded.
    read-too-large(u32),
  }

  /// A function of a loaded wasm program that a sample landed in.
  record wasm-function {
    /// The program the code was loaded for, as it was invoked.
    module: string,
    /// The core module of the program's component that defines the
    /// function; zero for a program that is one core module.
    static-module: u32,
    /// The function's index in its core module's function index space.
    index: u32,
    /// The function's name from the module's name section, when it has one.
    name: option<string>,
  }

  /// What a sampled instruction address was executing.
  variant sampled-code {
    /// A function of a loaded wasm program.
    wasm(wasm-function),
    /// An address inside the named program's code that belongs to none
    /// of its functions: the runtime's trampolines.
    wasm-trampoline(string),
    /// Any other address, as sampled. The kernel image is the only other
    /// code that runs; the reader decides whether the address lies in it
    /// against the image's own symbols, shifted by `kernel-image-base`.
    native(u64),
  }

  record instruction-sample {
    code: sampled-code,
    count: u64,
  }

  /// Every instruction address sampled since sampling last started.
  record instruction-profile {
    /// Interval between two samples on one processor while sampling ran.
    period-nanos: mono-nanos,
    /// Runtime address of the kernel image's lowest loadable segment.
    kernel-image-base: u64,
    /// Each distinct location and its sample count, the heaviest first.
    samples: list<instruction-sample>,
    /// Samples a processor's full buffer could not hold.
    dropped: u64,
  }

  /// Why the kernel could not produce an instruction profile.
  enum instruction-profile-error {
    /// The running backend does not sample instruction addresses.
    not-captured,
  }

  set-enabled: func(enabled: bool);
  clear: func();
  folded: func(filter: filter, limit: u32) -> list<folded-sample>;
  metrics: func(filter: metric-filter, limit: u32) -> list<metric-sample>;

  /// Starts or stops instruction-address sampling, independently of
  /// `set-enabled`. Sampling shortens every processor's timer period, so
  /// it perturbs timings and runs only when a reader asked for it.
  /// Starting discards the samples of any earlier run.
  set-instruction-sampling: func(enabled: bool) -> result<_, instruction-profile-error>;

  /// The instruction addresses the processors' periodic timer sampled
  /// since sampling last started, attributed to the code they executed.
  instruction-samples: func() -> result<instruction-profile, instruction-profile-error>;

  /// Length in bytes of the kernel's LLVM raw profile (`.profraw`).
  ///
  /// The length is fixed by the link rather than by what has executed, so
  /// a reader may ask once and then walk the image while the kernel keeps
  /// counting.
  raw-profile-size: func() -> result<u64, raw-profile-error>;

  /// The window of the raw profile starting at `offset`, at most `length`
  /// bytes. A window that reaches the end of the image is short, and an
  /// offset at the end returns nothing.
  raw-profile-read: func(offset: u64, length: u32) -> result<list<u8>, raw-profile-error>;
}
