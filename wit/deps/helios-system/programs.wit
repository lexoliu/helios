package helios:system@0.1.0;

/// Spawn user program artifacts.
///
/// Two entry points are exposed:
///
/// * `spawn` returns a `child` resource that gives the parent direct
///   access to the child's `wasi:cli/stdin/stdout/stderr` as byte
///   streams. This is the low-level API used by the guest shell to
///   implement pipes, redirection, and background jobs.
///
/// * `exec` is a higher-level convenience that spawns a program, blocks
///   until it completes, and hands the parent the child's stdout and
///   stderr as buffered byte arrays. It has no stdin input. It is meant
///   for the RPC path where a remote inspector just wants one-shot
///   "run and give me the output" semantics and does not need streaming.
///
/// Both end up running exactly the same executable image on exactly the
/// same runtime. `exec` is just `spawn` + drain + wait, modelled at the
/// interface boundary so the common case does not need to express
/// streams in its wire format.
interface programs {
  /// Stable identifier for a live program instance, used by the observer.
  type instance-id = u64;

  enum aot-hint {
    fast,
    balanced,
    performance,
  }

  enum filesystem-right {
    read,
    write,
    mutate-directory,
    execute,
  }

  record directory-grant {
    /// Directory path in the caller authority to derive from.
    source-path: string,
    /// Guest-visible preopen name in the child.
    guest-name: string,
    /// Rights granted to the child. These must be a subset of the
    /// caller's rights for `source-path`.
    rights: list<filesystem-right>,
  }

  enum network-right {
    tcp,
    udp,
    dns,
    privileged-bind,
    multicast,
    admin,
  }

  record network-grant {
    /// Network rights granted to the child. These must be a subset of
    /// the caller's network authority.
    rights: list<network-right>,
  }

  enum clock-right {
    set-wall-clock,
  }

  record clock-grant {
    /// Clock rights granted to the child. These must be a subset of
    /// the caller's clock authority.
    rights: list<clock-right>,
  }

  enum terminal-right {
    input,
    output,
    control,
  }

  record terminal-grant {
    /// Terminal rights granted to the child. These must be a subset of
    /// the caller's terminal authority.
    rights: list<terminal-right>,
  }

  enum process-right {
    spawn,
    exec,
    fork,
    join,
    signal,
  }

  record process-grant {
    /// Process-control rights granted to the child. These must be a
    /// subset of the caller's process authority.
    rights: list<process-right>,
  }

  enum link-right {
    source,
    target-directory,
    symlink-create,
    symlink-read,
  }

  record link-grant {
    /// Link rights granted to the child. These must be a subset of the
    /// caller's link authority and are separate from directory write.
    rights: list<link-right>,
  }

  variant capability-grant {
    directory(directory-grant),
    network(network-grant),
    clock(clock-grant),
    terminal(terminal-grant),
    process(process-grant),
    link(link-grant),
  }

  record spawn-request {
    /// Name the child is launched under. It becomes the child's
    /// `argv[0]` and names the instance for inspection and diagnostics.
    name: string,
    /// Argument vector passed to the launched component (argv[1..]).
    args: list<string>,
    /// Environment variables presented to the child via
    /// `wasi:cli/environment`.
    env: list<tuple<string, string>>,
    /// Path to an executable the caller is allowed to access.
    path: string,
    /// Explicit capabilities granted to the child. Empty means the
    /// child starts with no filesystem authority beyond its private
    /// stdio pipes.
    capability-grants: list<capability-grant>,
  }

  record exec-request {
    /// Name the child is launched under, which becomes its `argv[0]`.
    name: string,
    args: list<string>,
    env: list<tuple<string, string>>,
    path: string,
    /// Bytes piped into the child's stdin. Empty means "stdin closes
    /// immediately".
    stdin: list<u8>,
    hint: option<aot-hint>,
    /// Explicit capabilities granted to the child. Empty means the
    /// child starts with no filesystem authority beyond its private
    /// stdio pipes.
    capability-grants: list<capability-grant>,
  }

  record aot-request {
    source-path: string,
    destination-path: string,
    hint: aot-hint,
    /// Emit compiler-internal timing diagnostics for this request.
    profile: bool,
  }

  record aot-result {
    destination-path: string,
  }

  record exec-output {
    stdout: list<u8>,
    stderr: list<u8>,
  }

  record exec-result {
    instance-id: instance-id,
    exit-code: u32,
    output: exec-output,
  }

  record exit-status {
    instance-id: instance-id,
    code: u32,
  }

  enum spawn-error-kind {
    invalid-binary,
    missing-entry,
    unsupported-import,
    invalid-signature,
    invalid-path,
    permission-denied,
    invalid-hint,
    out-of-memory,
    unavailable,
    internal,
  }

  record spawn-error {
    kind: spawn-error-kind,
    detail: string,
  }

  /// `exec` and `spawn` share the same error shape.
  type exec-error-kind = spawn-error-kind;
  type exec-error = spawn-error;

  /// Handle to a running child program. Each stream accessor may be
  /// called at most once; subsequent calls return empty streams.
  /// Dropping the handle before `wait` completes terminates the child.
  resource child {
    /// Pipe bytes into the child's `wasi:cli/stdin`. Completing the
    /// returned future closes stdin and delivers EOF to the child.
    stdin: func(data: stream<u8>) -> future<result>;

    /// Read the child's `wasi:cli/stdout` as a byte stream.
    stdout: func() -> tuple<stream<u8>, future<result>>;

    /// Read the child's `wasi:cli/stderr` as a byte stream.
    stderr: func() -> tuple<stream<u8>, future<result>>;

    /// Await child completion and return its exit status.
    wait: async func() -> result<exit-status, spawn-error>;
  }

  /// Spawn a new program and return a handle for streaming its IO.
  spawn: async func(request: spawn-request) -> result<child, spawn-error>;

  /// Run a program to completion, returning its buffered stdout/stderr.
  /// Equivalent to `spawn` + drain output + `wait`.
  exec: async func(request: exec-request) -> result<exec-result, exec-error>;

  /// Ahead-of-time compile a raw wasm input into a signed `cwasm` output.
  aot: async func(request: aot-request) -> result<aot-result, exec-error>;
}
