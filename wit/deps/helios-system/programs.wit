package helios:system@0.1.0;

interface programs {
  /// Stable identifier for a live wasm instance.
  type instance-id = u64;

  record exec-request {
    /// User-visible instance name used for inspection and diagnostics.
    name: string,
    /// Argument vector passed to the launched component.
    args: list<string>,
    /// Raw wasm module bytes to JIT-compile and execute.
    wasm: list<u8>,
  }

  record exec-output {
    stdout: list<u8>,
    stderr: list<u8>,
  }

  record exec-result {
    instance-id: instance-id,
    exit-code: u32,
    output: exec-output,
  }

  enum exec-error-kind {
    invalid-binary,
    missing-entry,
    unsupported-import,
    queue-saturated,
    unavailable,
    internal,
  }

  record exec-error {
    kind: exec-error-kind,
    detail: string,
  }

  /// Executes a pure wasm program with the platform's default minimal rights and waits for completion.
  exec: async func(request: exec-request) -> result<exec-result, exec-error>;
}
