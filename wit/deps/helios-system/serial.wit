package helios:system@0.1.0;

interface serial {
  flags serial-rights {
    read,
    write,
    flush,
  }

  resource serial-port {
    rights: async func() -> serial-rights;
    read: async func(max-bytes: u32) -> list<u8>;
    write: async func(bytes: list<u8>);
    flush: async func();
  }

  debug-port: async func() -> option<serial-port>;
}
