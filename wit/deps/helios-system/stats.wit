package helios:system@0.1.0;

interface stats {
  /// Monotonic nanoseconds since system boot.
  type mono-nanos = u64;

  /// Wall-clock nanoseconds since the Unix epoch.
  type unix-nanos = u64;

  /// Utilization is reported in permille to avoid floating-point drift while
  /// still being precise enough for UI rendering and trend analysis.
  type permille = u16;

  enum memory-pressure {
    nominal,
    elevated,
    high,
    critical,
  }

  record processor {
    /// Stable logical processor index visible to user space.
    id: u32,
    /// Fraction of time spent doing useful work over the sampling window.
    busy: permille,
  }

  record processors {
    configured: u32,
    online: u32,
    utilization: list<processor>,
  }

  record memory {
    total-bytes: u64,
    available-bytes: u64,
    pressure: memory-pressure,
  }

  /// The block device the kernel owns, as it identified it at boot.
  record block-device {
    capacity-bytes: u64,
    block-bytes: u32,
    physical-block-bytes: u32,
    /// Whether the device commits a volatile write cache on request.
    flush: bool,
    /// Whether the device accepts deallocation hints.
    discard: bool,
    /// Whether the device writes runs of zeroes without carrying them.
    write-zeroes: bool,
    /// Independent request queues, and requests each may keep in flight.
    queues: u32,
    queue-depth: u32,
    /// Requests the kernel has issued, by kind.
    reads: u64,
    writes: u64,
    flushes: u64,
    discards: u64,
    write-zeroes-requests: u64,
  }

  /// One device the platform's IOMMU confines to its own domain.
  record iommu-endpoint {
    /// The endpoint identity the platform gave the device.
    endpoint: u32,
    /// The translation domain the device is attached to.
    domain: u32,
    /// Physical bytes that domain maps, interrupt doorbells included.
    mapped-bytes: u64,
  }

  /// The platform's I/O translation unit, absent on a machine that has
  /// none or whose devices cannot be put behind one.
  record iommu {
    /// The smallest page the unit maps.
    granule-bytes: u64,
    /// Whether endpoints attached to no domain still reach memory. A
    /// confined device is translated either way.
    global-bypass: bool,
    /// Translation faults the unit has reported since boot.
    faults: u64,
    endpoints: list<iommu-endpoint>,
  }

  /// The memory balloon the host resizes this guest through.
  record memory-balloon {
    /// Bytes the host has asked the guest to give up.
    target-bytes: u64,
    /// Bytes the guest has actually given up.
    actual-bytes: u64,
    /// Bytes named to the host as free in the last reporting pass.
    reported-bytes: u64,
  }

  /// How the in-kernel 9p client's caches have served the host share
  /// since boot. The share is not exclusive, so every table is bounded
  /// in entries and in time; these counters say how much of that budget
  /// is actually paying off.
  record host-share-cache {
    /// Attribute lookups answered from a cached `Rgetattr`.
    attribute-hits: u64,
    /// Attribute lookups that had to walk and ask the host.
    attribute-misses: u64,
    /// Attribute lookups answered "no such path" without asking.
    negative-hits: u64,
    /// Directory listings answered from a cached `Treaddir` sweep.
    directory-hits: u64,
    /// Directory listings that had to be read from the host.
    directory-misses: u64,
    /// Reads that reused a fid the pool already had open.
    fid-hits: u64,
    /// Reads that had to walk and open a fid of their own.
    fid-misses: u64,
    /// Entries dropped because a table was full or an entry went stale.
    evictions: u64,
    /// Entries dropped because the kernel changed what they described.
    invalidations: u64,
  }

  record sample {
    timestamp: mono-nanos,
    uptime: mono-nanos,
    /// Wall time, from the real-time clock the kernel read at boot.
    /// Zero on a machine that carried no such clock, where wall time
    /// cannot be told apart from uptime.
    wall-clock: unix-nanos,
    processors: processors,
    memory: memory,
    /// Absent on a machine that gave the kernel no block device.
    block: option<block-device>,
    /// Absent on a machine whose devices are not behind a translation
    /// unit, and therefore reach all of memory.
    iommu: option<iommu>,
    /// Absent on a machine that gave the kernel no memory balloon.
    balloon: option<memory-balloon>,
    /// Absent on a machine with no host share, or one whose host
    /// filesystem is reached without a 9p session in front of it.
    host-share: option<host-share-cache>,
  }

  /// Returns the latest coherent system-wide observation snapshot.
  snapshot: func() -> sample;

  /// Streams future snapshots at approximately the requested cadence.
  ///
  /// The kernel may coalesce wakeups, so this is a best-effort lower-bound
  /// interval rather than a hard real-time contract.
  subscribe: func(period: mono-nanos) -> stream<sample>;
}
