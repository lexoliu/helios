package helios:system@0.1.0;

interface stats {
  /// Monotonic nanoseconds since system boot.
  type mono-nanos = u64;

  /// Wall-clock nanoseconds since the Unix epoch.
  type unix-nanos = u64;

  /// Utilization is reported in permille to avoid floating-point drift while
  /// still being precise enough for UI rendering and trend analysis.
  type permille = u16;

  enum memory-pressure {
    nominal,
    elevated,
    high,
    critical,
  }

  record processor {
    /// Stable logical processor index visible to user space.
    id: u32,
    /// Fraction of time spent doing useful work over the sampling window.
    busy: permille,
  }

  record processors {
    configured: u32,
    online: u32,
    utilization: list<processor>,
  }

  /// The machine's memory, across both of the kernel's allocation
  /// domains.
  ///
  /// The kernel heap and the user pool draw on the same physical
  /// memory — the pool is seeded with everything the boot memory map
  /// described and the kernel heap takes what it needs out of it — so
  /// one number covers both. See `docs/memory.md`.
  record memory {
    /// Every usable byte the boot memory map described.
    total-bytes: u64,
    /// Bytes neither domain has handed out.
    available-bytes: u64,
    pressure: memory-pressure,
  }

  /// The block device the kernel owns, as it identified it at boot.
  record block-device {
    capacity-bytes: u64,
    block-bytes: u32,
    physical-block-bytes: u32,
    /// Whether the device commits a volatile write cache on request.
    flush: bool,
    /// Whether the device accepts deallocation hints.
    discard: bool,
    /// Whether the device writes runs of zeroes without carrying them.
    write-zeroes: bool,
    /// Independent request queues, and requests each may keep in flight.
    queues: u32,
    queue-depth: u32,
    /// Requests the kernel has issued, by kind.
    reads: u64,
    writes: u64,
    flushes: u64,
    discards: u64,
    write-zeroes-requests: u64,
  }

  /// One device the platform's IOMMU confines to its own domain.
  record iommu-endpoint {
    /// The endpoint identity the platform gave the device.
    endpoint: u32,
    /// The translation domain the device is attached to.
    domain: u32,
    /// Physical bytes that domain maps, interrupt doorbells included.
    mapped-bytes: u64,
  }

  /// The platform's I/O translation unit, absent on a machine that has
  /// none or whose devices cannot be put behind one.
  record iommu {
    /// The smallest page the unit maps.
    granule-bytes: u64,
    /// Whether endpoints attached to no domain still reach memory. A
    /// confined device is translated either way.
    global-bypass: bool,
    /// Translation faults the unit has reported since boot.
    faults: u64,
    endpoints: list<iommu-endpoint>,
  }

  /// The memory balloon the host resizes this guest through.
  record memory-balloon {
    /// Bytes the host has asked the guest to give up.
    target-bytes: u64,
    /// Bytes the guest has actually given up.
    actual-bytes: u64,
    /// Bytes named to the host as free in the last reporting pass.
    reported-bytes: u64,
  }

  /// Guest pages the kernel has moved out of memory, and what it cost
  /// to bring them back.
  record swap {
    /// What the pages are written to.
    backend: string,
    /// Bytes that store can hold.
    capacity-bytes: u64,
    /// Bytes of it currently holding pages.
    used-bytes: u64,
    /// Pages written out since boot.
    pages-out: u64,
    /// Pages read back in since boot.
    pages-in: u64,
    /// Guest faults resolved by reading a page back.
    faults-served: u64,
    /// Mean time a faulting guest waited, over every fault served.
    mean-fault-latency: mono-nanos,
  }

  /// How the in-kernel 9p client's caches have served the host share
  /// since boot. The share is not exclusive, so every table is bounded
  /// in entries and in time; these counters say how much of that budget
  /// is actually paying off.
  record host-share-cache {
    /// Attribute lookups answered from a cached `Rgetattr`.
    attribute-hits: u64,
    /// Attribute lookups that had to walk and ask the host.
    attribute-misses: u64,
    /// Attribute lookups answered "no such path" without asking.
    negative-hits: u64,
    /// Directory listings answered from a cached `Treaddir` sweep.
    directory-hits: u64,
    /// Directory listings that had to be read from the host.
    directory-misses: u64,
    /// Reads that reused a fid the pool already had open.
    fid-hits: u64,
    /// Reads that had to walk and open a fid of their own.
    fid-misses: u64,
    /// Entries dropped because a table was full or an entry went stale.
    evictions: u64,
    /// Entries dropped because the kernel changed what they described.
    invalidations: u64,
  }

  /// One network queue pair, and the shard and processor that own it.
  record network-queue {
    /// The shard, and therefore the processor and the queue pair.
    id: u32,
    /// Frames this shard's stack took off the device.
    rx-frames: u64,
    /// Frames it handed back to the device.
    tx-frames: u64,
    /// Interrupts the device raised for this pair's own message. Zero on
    /// a transport that cannot tell its queues apart, where every
    /// completion arrives on one line.
    interrupts: u64,
    /// Frames the demux threw away because this shard's stack had no
    /// room for them. They were already off the ring when they were
    /// refused, so they are lost and the peer has to retransmit.
    rx-refused-frames: u64,
    /// Acknowledgements this shard has put on the wire, duplicates
    /// included.
    tcp-acks-sent: u64,
    /// Those of them that advertised more receive room than the peer had
    /// last been told about. A receiver whose window shut and whose
    /// update count then stopped moving is a stalled transfer.
    tcp-window-updates-sent: u64,
    /// Segments this shard retransmitted, by timer or fast retransmit.
    tcp-retransmits-sent: u64,
    /// Connections this shard holds.
    tcp-sockets: u32,
    /// How many of them are refusing segments for want of receive room.
    /// Nonzero while `tcp-sockets` is zero is a leaked window: the shard
    /// refuses frames with no socket left that could relieve it.
    tcp-receive-backpressured-sockets: u32,
    /// The receive window those connections advertise between them, in
    /// bytes. Zero with connections open is a shut receiver.
    tcp-receive-window-bytes: u64,
  }

  /// How the interface's work is spread across processors.
  ///
  /// One entry per shard, which is one per processor. A device that
  /// steers by flow hash puts each flow's frames on the queue whose
  /// processor owns the socket, so both the frame counts and the
  /// interrupt counts spread; a device that cannot steer leaves every
  /// frame on the first entry.
  record network {
    queues: list<network-queue>,
  }

  record sample {
    timestamp: mono-nanos,
    uptime: mono-nanos,
    /// Wall time, from the real-time clock the kernel read at boot.
    /// Zero on a machine that carried no such clock, where wall time
    /// cannot be told apart from uptime.
    wall-clock: unix-nanos,
    processors: processors,
    memory: memory,
    /// Absent on a machine that gave the kernel no block device.
    block: option<block-device>,
    /// Absent on a machine whose devices are not behind a translation
    /// unit, and therefore reach all of memory.
    iommu: option<iommu>,
    /// Absent on a machine that gave the kernel no memory balloon.
    balloon: option<memory-balloon>,
    /// Absent on a machine with no swap: one whose address space cannot
    /// fault a swapped-out page back in, or that has no disk to write
    /// pages to.
    swap: option<swap>,
    /// Absent on a machine with no host share, or one whose host
    /// filesystem is reached without a 9p session in front of it.
    host-share: option<host-share-cache>,
    /// Absent on a machine that gave the kernel no network device.
    network: option<network>,
  }

  /// Returns the latest coherent system-wide observation snapshot.
  snapshot: func() -> sample;

  /// Streams future snapshots at approximately the requested cadence.
  ///
  /// The kernel may coalesce wakeups, so this is a best-effort lower-bound
  /// interval rather than a hard real-time contract.
  subscribe: func(period: mono-nanos) -> stream<sample>;
}
