package helios:system@0.1.0;

interface tracing {
  /// Monotonic nanoseconds since system boot.
  type mono-nanos = u64;

  enum level {
    error,
    warn,
    info,
    debug,
    trace,
  }

  variant value {
    boolean(bool),
    signed64(s64),
    unsigned64(u64),
    float64(f64),
    text(string),
    blob(list<u8>),
  }

  record field {
    key: string,
    value: value,
  }

  /// A tracing event as exposed to user space.
  ///
  /// This intentionally exposes the event payload only. It does not leak
  /// internal span ids, scheduler state, or source file locations from the
  /// kernel implementation.
  record event {
    timestamp: mono-nanos,
    level: level,
    target: string,
    fields: list<field>,
  }

  record filter {
    /// Minimum included level. `none` means no level filter.
    min-level: option<level>,
    /// Prefix matches on tracing target. Empty means no target restriction.
    target-prefixes: list<string>,
  }

  /// Why `set-target-enabled` refused a name.
  variant target-error {
    /// The kernel gates no diagnostic target under the name given.
    unknown-target(string),
  }

  /// Enables or disables a kernel diagnostic target by name.
  ///
  /// Diagnostic targets are off by default so their events cost
  /// nothing; enabling one opens the kernel's console filter for the
  /// rest of the boot. The name is the `tracing` target the kernel
  /// emits under — `helios_kernel::exec::phases`, for one — and a name
  /// nothing registered is refused so a typo says so instead of
  /// producing an empty log.
  set-target-enabled: func(target: string, enabled: bool) -> result<_, target-error>;

  /// Returns at most `limit` newest matching events, ordered oldest to newest.
  recent: func(filter: filter, limit: u32) -> list<event>;

  /// Subscribes to future matching events.
  subscribe: func(filter: filter) -> stream<event>;
}
