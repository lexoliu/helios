package helios:system@0.1.0;

/// Attach filesystems to the guest path tree.
///
/// Every path a program resolves goes through the kernel's mount table:
/// the longest mount point that covers the path owns it. A mount is seen
/// by every program. Attaching or detaching one takes the mount authority
/// (`programs.mount-grant`) and mutate-directory authority over the mount
/// point, since a mount replaces what that directory shows.
interface mounts {
  /// A filesystem the kernel can attach.
  variant mount-source {
    /// A new, empty filesystem held in memory.
    memory,
    /// The boot image the kernel was started with. Always read-only.
    boot-image,
    /// The host share, when the platform attached one.
    host-share,
    /// The EROFS image on the disk that reported this serial. Always
    /// read-only.
    disk(string),
    /// The btrfs image on the disk that reported this serial.
    btrfs(string),
  }

  /// Whether a mount belongs to one container or may be seen by many,
  /// fixed for as long as the mount exists. For a WASI or WASIX program
  /// the two are the same: the mount's rights are all it holds, and it
  /// sees no owner, group or mode.
  enum mount-sharing {
    /// The mount belongs to one container, which sees the ownership,
    /// modes, set-id bits and file capabilities the filesystem stores and
    /// is held to them within the mount's rights.
    private,
    /// The mount may be granted to several containers and to WASI programs
    /// at once. In each container every node appears owned by the identity
    /// the container's configuration names, its modes follow the mount's
    /// rights, and the mount is nosuid and nodev, with file capabilities
    /// ignored.
    shared,
  }

  record mount-request {
    source: mount-source,
    /// Directory path in the caller authority to attach the filesystem
    /// at. It must be a directory, or not exist, inside a directory.
    path: string,
    /// Attach for reading only.
    read-only: bool,
    /// Whether the mount is private or shared.
    sharing: mount-sharing,
    /// The value of Linux's `compress=` mount option, such as `zstd:3`,
    /// `zlib`, `lzo` or `no`: the compression new data of a writable btrfs
    /// mount is written with. Absent writes uncompressed. A source other than
    /// btrfs refuses it.
    compress: option<string>,
    /// The value of Linux's `commit=` mount option: the longest, in seconds,
    /// a change to a writable btrfs mount waits before it is committed when
    /// nothing syncs it. Absent or zero takes Linux's default of 30. A
    /// source other than btrfs refuses it.
    commit: option<u32>,
  }

  enum mount-error-kind {
    /// The caller lacks the mount right, or mutate-directory authority
    /// over the mount point.
    permission-denied,
    /// The path is not a mount point: the root, or not normalized.
    invalid-point,
    /// Something is already mounted at the path.
    already-mounted,
    /// Nothing is mounted at the path.
    not-mounted,
    /// Another mount lies below the one being detached.
    busy,
    /// The mount table has no room for another mount.
    table-full,
    /// The source is not attached to this machine.
    unavailable,
    /// The mount point, or the directory holding it, cannot take a mount.
    invalid-path,
    /// The source holds no filesystem the kernel can read: a malformed
    /// image, or one whose checksum does not match.
    invalid-filesystem,
    /// Reading the source failed.
    io,
    /// A mount option is malformed, names something the source does not
    /// take, or asks for a level the kernel cannot encode.
    invalid-option,
  }

  record mount-error {
    kind: mount-error-kind,
    detail: string,
  }

  /// Attaches a filesystem.
  mount: async func(request: mount-request) -> result<_, mount-error>;

  /// Detaches the filesystem mounted at `path`.
  unmount: async func(path: string) -> result<_, mount-error>;
}
