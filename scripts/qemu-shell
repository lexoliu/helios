#!/usr/bin/env bash
set -euo pipefail

usage() {
  printf '%s\n' "Usage: scripts/qemu-shell [options] [-- inspector-args...]"
  printf '%s\n' "Options:"
  printf '%s\n' "  --no-build           Skip cargo build steps."
  printf '%s\n' "  --qemu-bin PATH      QEMU executable. Default: qemu-system-riscv64."
  printf '%s\n' "  --kernel PATH        Kernel image path."
  printf '%s\n' "  --shell-bin PATH     Host inspector binary path."
  printf '%s\n' "  --socket PATH        Unix socket path for the debug serial link."
  printf '%s\n' "  --smp N              Processor count for QEMU. Default: 4."
  printf '%s\n' "  --memory SIZE        Guest RAM size. Default: 512M."
  printf '%s\n' "  --bios VALUE         QEMU -bios argument. Default: default."
  printf '%s\n' "  --baud RATE          Inspector baud rate hint. Default: 115200."
  printf '%s\n' "  --help               Show this message."
  printf '%s\n' "Example:"
  printf '%s\n' "  scripts/qemu-shell"
  printf '%s\n' "  scripts/qemu-shell -- stats"
}

repo_root=$(
  cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." &&
    pwd
)

kernel_target="riscv64gc-unknown-none-elf"
qemu_bin="${QEMU_BIN:-qemu-system-riscv64}"
kernel_image="${KERNEL_IMAGE:-$repo_root/target/$kernel_target/debug/helios}"
shell_bin="${SHELL_BIN:-$repo_root/target/debug/helios-inspector}"
socket_path=""
socket_dir=""
qemu_log=""
build=1
smp=4
memory="512M"
bios="default"
baud="115200"
shell_args=()

while (($# > 0)); do
  case "$1" in
    --no-build)
      build=0
      shift
      ;;
    --qemu-bin)
      qemu_bin="$2"
      shift 2
      ;;
    --kernel)
      kernel_image="$2"
      shift 2
      ;;
    --shell-bin)
      shell_bin="$2"
      shift 2
      ;;
    --socket)
      socket_path="$2"
      shift 2
      ;;
    --smp)
      smp="$2"
      shift 2
      ;;
    --memory)
      memory="$2"
      shift 2
      ;;
    --bios)
      bios="$2"
      shift 2
      ;;
    --baud)
      baud="$2"
      shift 2
      ;;
    --help)
      usage
      exit 0
      ;;
    --)
      shift
      shell_args=("$@")
      break
      ;;
    *)
      printf 'unknown argument: %s\n' "$1" >&2
      usage >&2
      exit 1
      ;;
  esac
done

if [[ "$smp" =~ ^[0-9]+$ ]] && ((smp < 2)); then
  printf '%s\n' "QEMU must run with at least 2 harts because the embedded debugger occupies a dedicated hart." >&2
  exit 1
fi

if [[ -z "$socket_path" ]]; then
  socket_dir=$(mktemp -d "${TMPDIR:-/tmp}/helios-qemu-shell.XXXXXX")
  socket_path="$socket_dir/debug.sock"
fi

if [[ -n "$socket_dir" ]]; then
  qemu_log="$socket_dir/qemu.log"
else
  qemu_log="$(dirname "$socket_path")/qemu.log"
fi

qemu_pid=""

cleanup() {
  if [[ -n "$qemu_pid" ]] && kill -0 "$qemu_pid" 2>/dev/null; then
    kill "$qemu_pid" 2>/dev/null || true
    wait "$qemu_pid" 2>/dev/null || true
  fi

  if [[ -n "$socket_dir" ]] && [[ -d "$socket_dir" ]]; then
    rm -rf "$socket_dir"
  fi
}

trap cleanup EXIT INT TERM

require_command() {
  if ! command -v "$1" >/dev/null 2>&1; then
    printf 'missing required command: %s\n' "$1" >&2
    exit 1
  fi
}

wait_for_socket() {
  local attempts

  for attempts in $(seq 1 200); do
    if [[ -S "$socket_path" ]]; then
      return 0
    fi

    if ! kill -0 "$qemu_pid" 2>/dev/null; then
      wait "$qemu_pid"
      printf '%s\n' "QEMU exited before opening the debug serial socket." >&2
      if [[ -f "$qemu_log" ]]; then
        printf 'QEMU log:\n' >&2
        cat "$qemu_log" >&2
      fi
      exit 1
    fi

    sleep 0.05
  done

  printf 'timed out waiting for QEMU to create socket %s\n' "$socket_path" >&2
  exit 1
}

require_command cargo
require_command "$qemu_bin"

if ((build)); then
  cargo build --target "$kernel_target" --bin helios
  cargo build -p helios-inspector
fi

if [[ ! -x "$shell_bin" ]]; then
  printf 'shell binary is missing: %s\n' "$shell_bin" >&2
  exit 1
fi

if [[ ! -f "$kernel_image" ]]; then
  printf 'kernel image is missing: %s\n' "$kernel_image" >&2
  exit 1
fi

"$qemu_bin" \
  -machine virt \
  -display none \
  -monitor none \
  -m "$memory" \
  -smp "$smp" \
  -bios "$bios" \
  -netdev user,id=net0 \
  -device virtio-net-device,netdev=net0 \
  -kernel "$kernel_image" \
  -serial "unix:$socket_path,server=on,wait=on" \
  >"$qemu_log" 2>&1 &
qemu_pid=$!

wait_for_socket

if ((${#shell_args[@]} > 0)); then
  "$shell_bin" --boot-sync --device "$socket_path" --baud "$baud" "${shell_args[@]}"
else
  "$shell_bin" --boot-sync --device "$socket_path" --baud "$baud"
fi
