pub const EMBEDDED_INIT: Option<EmbeddedInitDescriptor> = Some(EmbeddedInitDescriptor {
    component: EmbeddedComponent::new(
        r#"{{ name }}"#,
        include_bytes!(r#"{{ component }}"#),
    ),
    argv0: r#"{{ argv0 }}"#,
    bootfs: EmbeddedBootFs::new(&[
{% for directory in bootfs_directories %}
        EmbeddedBootDirectory::new(r#"{{ directory.path }}"#, {{ directory.modified_nanos }}),
{% endfor %}
    ], &[
{% for file in bootfs_files %}
        EmbeddedBootFile::new(r#"{{ file.path }}"#, include_bytes!(r#"{{ file.source }}"#), {{ file.modified_nanos }}),
{% endfor %}
    ]),
});
