package helios:system@0.1.0;

interface serial {
  flags serial-rights {
    read,
    write,
    flush,
  }

  resource serial-port {
    rights: func() -> serial-rights;
    read: func(max-bytes: u32) -> future<list<u8>>;
    write: func(bytes: list<u8>) -> future;
    flush: func() -> future;
  }

  debug-port: func() -> option<serial-port>;
}
